    <mxCell id="ledt" value="voyant (sur le cadre,&#10;jamais sur la trappe)" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="-30" y="115" width="90" height="30" as="geometry" /></mxCell>

    <mxCell id="capt" value="au repos : ressort maintient le pêne en position verrouillée (fail-secure).&#10;impulsion momentanée du solénoïde : rétracte le pêne le temps d'ouvrir; le biseau du pêne le reverrouille seul à la fermeture — aucun signal requis pour se reverrouiller." style="text;html=1;fontSize=10;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="600" height="50" as="geometry" /></mxCell>
