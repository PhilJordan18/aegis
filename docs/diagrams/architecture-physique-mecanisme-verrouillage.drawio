    <mxCell id="door" value="trappe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="150" height="180" as="geometry" /></mxCell>

    <mxCell id="bolt" value="pêne&#10;(verrouillé)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#854F0B;strokeColor=none;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="35" height="14" as="geometry" /></mxCell>
    <mxCell id="springarrow" value="ressort (pousse le&#10;pêne vers l'extérieur)" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#854F0B;fontSize=9;fontColor=#854F0B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="157" as="sourcePoint"/><mxPoint x="68" y="157" as="targetPoint"/></mxGeometry></mxCell>

    <mxCell id="solenoid" value="solénoïde" style="pointerEvents=1;shadow=0;dashed=0;html=1;shape=mxgraph.electrical.electro-mechanical.relay_coil;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="70" height="35" as="geometry" /></mxCell>
    <mxCell id="pulsearrow" value="impulsion brève →&#10;rétracte le pêne" style="endArrow=block;dashed=1;html=1;strokeColor=#854F0B;fontSize=9;fontColor=#854F0B;" edge="1" parent="1" source="solenoid" target="bolt"><mxGeometry relative="1" as="geometry" /></mxCell>

