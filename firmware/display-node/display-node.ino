// Display node of the hub screen on the Freenove ESP32 Display 3.2" (FNK0103 / E32R32P).
// I2C slave of the hub (frame v1, src/display_frame.h): it draws what the hub sends and proves
// each draw through its status; the link logic is src/cyd_state.h, this file is the wiring.
// Text, logo and icons are pre-rendered anti-aliased bitmaps (assets.h, generated by tools/gen_assets.py from Inter, SIL OFL).
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <SPI.h>
#include <Wire.h>
#include "types.h"
#include "assets.h"
#include "src/cyd_state.h"

using namespace aegis;

static const int PIN_SCLK = 14, PIN_MISO = 12, PIN_MOSI = 13, PIN_CS = 15, PIN_DC = 2;
static const int PIN_BL = 27;  // LCDWiki E32R32P backlight
static const uint8_t I2C_ADDRESS = 0x42;
static const int PIN_SDA = 32, PIN_SCL = 25;  // the CYD's 4-pin I2C connector

Adafruit_ST7789 tft(&SPI, PIN_CS, PIN_DC, -1);

static uint16_t rgb(uint32_t h) { return tft.color565((h >> 16) & 0xFF, (h >> 8) & 0xFF, h & 0xFF); }
static uint32_t WHITE_RGB = 0xFFFFFF, NAVY_RGB = 0x0F1B3D, GRAY_RGB = 0x5B6785, BLUE_RGB = 0x234BCE, RED_RGB = 0xB3261E;
static uint16_t WHITE, LINE, TEAL, BLUE, RED;

// ---- anti-aliased text ----------------------------------------------------------------------
static uint32_t nextCp(const uint8_t*& p) {
  uint32_t c = *p++;
  if (c < 0x80) return c;
  if ((c & 0xE0) == 0xC0) return ((c & 0x1F) << 6) | (*p++ & 0x3F);
  if ((c & 0xF0) == 0xE0) {
    uint32_t c1 = *p++ & 0x3F, c2 = *p++ & 0x3F;
    return ((c & 0x0F) << 12) | (c1 << 6) | c2;
  }
  return '?';
}

static const AAGlyph* findGlyph(const AAFont& f, uint32_t cp) {
  for (int pass = 0; pass < 2; pass++) {
    for (uint16_t i = 0; i < f.n; i++)
      if (f.glyphs[i].cp == cp) return &f.glyphs[i];
    cp = '?';
  }
  return &f.glyphs[0];
}

static float textWidth(const char* s, const AAFont& f, int spacing = 0) {
  float w = 0;
  int n = 0;
  for (const uint8_t* p = (const uint8_t*)s; *p; n++) w += findGlyph(f, nextCp(p))->adv / 256.0f;
  return w + spacing * (n > 0 ? n - 1 : 0);
}

// Text is always drawn on white: coverage blends the colour over white.
static void drawGlyph(const AAFont& f, const AAGlyph* g, int x, int baseline, uint32_t color) {
  if (!g->w || !g->h) return;
  static uint16_t buf[40 * 40];
  const uint8_t* bits = f.bits + g->off;
  const int r = (color >> 16) & 0xFF, gr = (color >> 8) & 0xFF, b = color & 0xFF;
  for (int i = 0; i < g->w * g->h; i++) {
    int a = bits[i];
    int rr = 255 - ((255 - r) * a) / 255, gg = 255 - ((255 - gr) * a) / 255, bb = 255 - ((255 - b) * a) / 255;
    buf[i] = tft.color565(rr, gg, bb);
  }
  tft.drawRGBBitmap(x + g->x0, baseline + g->y0, buf, g->w, g->h);
}

// align 0: `x` is the left edge, 1: the centre, 2: the right edge.
static void drawText(const char* s, int x, int baseline, const AAFont& f, uint32_t color, int align = 0, int spacing = 0) {
  float w = textWidth(s, f, spacing);
  float cx = align == 1 ? x - w / 2 : align == 2 ? x - w : x;
  for (const uint8_t* p = (const uint8_t*)s; *p;) {
    const AAGlyph* g = findGlyph(f, nextCp(p));
    drawGlyph(f, g, (int)roundf(cx), baseline, color);
    cx += g->adv / 256.0f + spacing;
  }
}

static void drawWrapped(const char* s, int cx, int baseline, int maxW, int lineH, const AAFont& f, uint32_t color) {
  char line[96] = "", word[48];
  const char* p = s;
  while (*p) {
    int k = 0;
    while (*p && *p != ' ' && k < 47) word[k++] = *p++;
    word[k] = 0;
    while (*p == ' ') p++;
    char trial[96];
    snprintf(trial, sizeof trial, "%s%s%s", line, line[0] ? " " : "", word);
    if (line[0] && textWidth(trial, f) > maxW) {
      drawText(line, cx, baseline, f, color, 1);
      baseline += lineH;
      snprintf(line, sizeof line, "%s", word);
    } else {
      snprintf(line, sizeof line, "%s", trial);
    }
  }
  if (line[0]) drawText(line, cx, baseline, f, color, 1);
}

static void drawImg(const uint16_t* img, int x, int y, int w, int h) { tft.drawRGBBitmap(x, y, img, w, h); }

// ---- screens --------------------------------------------------------------------------------
static void header() {
  drawImg(IMG_MARK22, 16, 9, IMG_MARK22_W, IMG_MARK22_H);
  drawText("AEGIS", 46, 25, FONT_B14, NAVY_RGB, 0, 4);
}

static void screenHome() {
  tft.fillScreen(WHITE);
  drawImg(IMG_MARK108, 66, 44, IMG_MARK108_W, IMG_MARK108_H);
  drawText("AEGIS", 120, 216, FONT_B28, NAVY_RGB, 1, 8);
  tft.fillRect(100, 246, 40, 2, TEAL);
  drawText("Gestion sécurisée des actifs", 120, 278, FONT_R12, GRAY_RGB, 1);
}

// qrcodegen (Nayuki) is compiled into the core's qrcode component without its header; this is the
// signature esp_qrcode_generate calls it with. Called directly so its two buffers are ours to wipe
// (esp_qrcode_generate frees its heap copies without wiping them).
extern "C" bool qrcodegen_encodeText(const char* text, uint8_t tempBuffer[], uint8_t qrcode[], int ecl,
                                     int minVersion, int maxVersion, int mask, bool boostEcl);
extern "C" int qrcodegen_getSize(const uint8_t qrcode[]);
extern "C" bool qrcodegen_getModule(const uint8_t qrcode[], int x, int y);
static const int QR_MAX_VERSION = 9;  // 230 bytes at ECC L: the frame's MAX_URI; 53 modules
static const int QR_BUF = ((QR_MAX_VERSION * 4 + 17) * (QR_MAX_VERSION * 4 + 17) + 7) / 8 + 1;
static uint8_t g_qr[QR_BUF], g_qrTmp[QR_BUF];

static void qrHeader(int secs) {
  tft.fillRect(0, 0, 240, 41, WHITE);
  header();
  char buf[8];
  snprintf(buf, sizeof buf, "%d s", secs);
  drawText(buf, 224, 25, FONT_S13, BLUE_RGB, 2);
  tft.fillRect(0, 37, 240, 3, LINE);
  tft.fillRect(0, 37, 240 * secs / 60, 3, secs <= 10 ? RED : BLUE);
}

static const char* actionLabel(uint8_t action) { return action == displayframe::RETURN ? "Retour" : "Retrait"; }

// Modules at up to 7 px (the POC-04 size); a version 9 code (53 modules) gets 4 px, 212 px plus a
// 2-module quiet zone of white screen. The bench QR card does not fit around it and is not drawn.
static void screenQr(uint8_t action, const char* code, int secs) {
  tft.fillScreen(WHITE);
  qrHeader(secs);
  const int n = qrcodegen_getSize(g_qr), scale = min(7, 212 / n), px = n * scale;
  const int x0 = (240 - px) / 2, y0 = 48;
  for (int y = 0; y < n; y++)
    for (int x = 0; x < n; x++)
      if (qrcodegen_getModule(g_qr, x, y)) tft.fillRect(x0 + x * scale, y0 + y * scale, scale, scale, 0x0000);
  drawText("Scannez avec l’application Aegis", 120, 277, FONT_R11, GRAY_RGB, 1);
  char line[40];
  snprintf(line, sizeof line, "%s · Casier %s", actionLabel(action), code);
  drawText(line, 120, 303, FONT_B17, NAVY_RGB, 1);
}

static void screenResult(ScreenResult r, uint8_t action, const char* code, uint16_t ttlMs) {
  tft.fillScreen(WHITE);
  header();
  tft.fillRect(0, 37, 240, 1, LINE);
  const uint16_t* icon = nullptr;
  const char* sub;
  char title[40], casier[24];
  snprintf(casier, sizeof casier, "Casier %s", code);
  switch (r) {
    case RES_OK: icon = IMG_ICON_OK; snprintf(title, sizeof title, "%s confirmé", actionLabel(action)); sub = casier; break;
    case RES_EXPIRED: icon = IMG_ICON_EXPIRED; snprintf(title, sizeof title, "Code expiré"); sub = "Relancez l’opération dans l’application."; break;
    case RES_FAILED: icon = IMG_ICON_FAILED; snprintf(title, sizeof title, "Opération non aboutie"); sub = "Consultez l’application pour le détail."; break;
    case RES_ANOMALY: icon = IMG_ICON_ANOMALY; snprintf(title, sizeof title, "Anomalie détectée"); sub = "Contactez un responsable."; break;
    default: snprintf(title, sizeof title, "Statut de l’opération"); sub = "Consultez l’application pour le détail.";
  }
  if (icon) drawImg(icon, 68, 84, 104, 104);
  drawText(title, 120, 232, textWidth(title, FONT_B20) <= 216 ? FONT_B20 : FONT_B17, NAVY_RGB, 1);
  drawWrapped(sub, 120, 258, 200, 18, FONT_R13, GRAY_RGB);
  char back[40];
  snprintf(back, sizeof back, "Retour à l’accueil dans %u s", (unsigned)((ttlMs + 999) / 1000));
  drawText(back, 120, 306, FONT_R10, GRAY_RGB, 1);
}

// ---- link ------------------------------------------------------------------------------------
static int g_secs = -1;  // countdown shown on the QR screen
static portMUX_TYPE g_mux = portMUX_INITIALIZER_UNLOCKED;

class Board : public CydBoard {
 public:
  bool drawChallenge(uint8_t action, const char* code, const char* uri, uint16_t ttlMs) override {
    const bool ok = qrcodegen_encodeText(uri, g_qrTmp, g_qr, 0 /* ECC L */, 1, QR_MAX_VERSION, -1 /* auto mask */, true);
    if (ok) {
      g_secs = (ttlMs + 999) / 1000;
      screenQr(action, code, g_secs);
    }
    memset(g_qr, 0, sizeof g_qr);  // the matrix encodes the token
    memset(g_qrTmp, 0, sizeof g_qrTmp);
    return ok;
  }
  bool drawStatus(uint8_t action, const char* code, const char* status, uint16_t ttlMs) override {
    const ScreenResult r = !strcmp(status, "CONFIRMED") ? RES_OK
                           : !strcmp(status, "EXPIRED") ? RES_EXPIRED
                           : !strcmp(status, "FAILED")  ? RES_FAILED
                           : !strcmp(status, "ANOMALY") ? RES_ANOMALY
                                                        : RES_OTHER;
    screenResult(r, action, code, ttlMs);
    return true;
  }
  void drawHome() override { screenHome(); }
  // On the classic ESP32 the slave cannot stretch SCL: a master read returns what is already in
  // the TX FIFO, and slaveWrite() resets the FIFO before filling it.
  void preload(const uint8_t* status) override { Wire.slaveWrite(status, displayframe::STATUS_LEN); }
  void lock() override { portENTER_CRITICAL(&g_mux); }
  void unlock() override { portEXIT_CRITICAL(&g_mux); }
  void log(uint8_t cmd, uint32_t seq, uint8_t state, uint8_t err) override {
    Serial.printf("cmd=%u seq=%lu state=%u err=%u\n", cmd, (unsigned long)seq, state, err);
  }
};

static Board g_board;
static CydState g_node(g_board, esp_random());

// Wire keeps its own copy of the last write in a protected buffer; this reaches it to wipe it.
struct WireRx : TwoWire {
  static uint8_t* TwoWire::*buffer() { return &WireRx::rxBuffer; }
};
static const size_t WIRE_BUFFER = displayframe::MAX_FRAME;

// I2C task: copy into the mailbox, nothing else.
static void onReceive(int n) {
  static uint8_t buf[WIRE_BUFFER];
  const size_t len = n > 0 ? (size_t)n : 0;
  for (size_t i = 0; i < len && i < sizeof buf; i++) buf[i] = Wire.read();
  g_node.receive(buf, len, millis());
  memset(buf, 0, sizeof buf);
  memset(Wire.*WireRx::buffer(), 0, WIRE_BUFFER);
}

// I2C task, after a master read: preload the status again for the next one.
static void onRequest() {
  uint8_t s[displayframe::STATUS_LEN];
  g_node.status(s);
  Wire.slaveWrite(s, sizeof s);
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BL, OUTPUT);
  digitalWrite(PIN_BL, HIGH);
  SPI.begin(PIN_SCLK, PIN_MISO, PIN_MOSI, PIN_CS);
  tft.setSPISpeed(40000000);
  tft.init(240, 320);
  tft.setRotation(0);
  WHITE = rgb(WHITE_RGB); LINE = rgb(0xE3E8F1); TEAL = rgb(0x087A9B); BLUE = rgb(BLUE_RGB); RED = rgb(RED_RGB);

  // 255, not 256: the core copies a write with a uint8_t index (Wire.cpp onReceiveService), so a
  // 256-byte write would loop forever; a 255-byte ring buffer never hands it more than 255.
  Wire.setBufferSize(WIRE_BUFFER);
  Wire.onReceive(onReceive);
  Wire.onRequest(onRequest);
  if (!Wire.begin(I2C_ADDRESS, PIN_SDA, PIN_SCL, 100000)) Serial.println("i2c slave init failed");
  g_node.begin();  // home screen, IDLE, status preloaded
  Serial.println("display node: up");
}

void loop() {
  const uint32_t now = millis();
  g_node.loop(now);
  if (g_node.screen() == CydState::CHALLENGE) {
    const int secs = (g_node.remainingMs(now) + 999) / 1000;
    if (secs != g_secs) {
      g_secs = secs;
      qrHeader(secs);
    }
  }
  delay(1);
}
