// Copy to secrets.h (git-ignored) and fill in. Never commit secrets.h.
#pragma once

#define WIFI_SSID "lab-wifi"
#define WIFI_PASSWORD "change-me"

// Must match a subjectAltName of the broker certificate (see infra/mqtt/README.md).
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 8883

// Stable device key; the MQTT clientId becomes aegis-locker-<DEVICE_KEY> (doc 10 §4.1).
#define DEVICE_KEY "hub-lab-01"
// Lowercase canonical UUID; also the MQTT username (infra/mqtt/provision-device.sh).
#define LOCKER_ID "00000000-0000-4000-8000-000000000001"
// Printed once by infra/mqtt/provision-device.sh.
#define MQTT_PASSWORD "change-me"

// Compartment ids of cells A1 and A2 as known by the backend.
#define COMPARTMENT_A1_ID "00000000-0000-4000-8000-0000000000a1"
#define COMPARTMENT_A2_ID "00000000-0000-4000-8000-0000000000a2"

// Lab CA certificate (infra/mqtt/certs/generate-lab-certs.sh), PEM.
static const char MQTT_CA_PEM[] = R"PEM(-----BEGIN CERTIFICATE-----
replace with the lab CA certificate
-----END CERTIFICATE-----
)PEM";
