# Local simulator credentials only. Replace these values in an ignored .env file.
AEGIS_DB_PASSWORD=local-demo-db-password-change-me
AEGIS_DB_PORT=5432
AEGIS_MQTT_PORT=1883
AEGIS_MQTT_API_PASSWORD=local-demo-api-password-change-me
AEGIS_MQTT_DEVICE_PASSWORD=local-demo-device-password-change-me
AEGIS_MQTT_TEST_DEVICE_PASSWORD=local-test-device-password-change-me

# TLS listener for the real hub, used only with compose.tls.yaml (infra/mqtt/README.md).
# Directory holding ca.crt, server.crt and server.key, relative to infra/docker/.
AEGIS_MQTT_CERT_DIR=../mqtt/certs/lab/broker
# 127.0.0.1 keeps 8883 on this machine. Set the laptop's LAN address to let the hub in.
AEGIS_MQTT_TLS_BIND=127.0.0.1
AEGIS_MQTT_TLS_PORT=8883
