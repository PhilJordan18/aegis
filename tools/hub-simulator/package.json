{
  "name": "aegis-hub-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Aegis Locker Node simulator speaking the MQTT contract (doc 10) without the physical hub",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "mqtt": "5.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
